{
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/write-guard.mjs\"" }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git push*)",
      "Bash(git * push*)"
    ],
    "allow": [
      "Bash(node .agent/tools/*)",
      "Bash(node --test *)",
      "Bash(node --check *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)"
    ]
  }
}
